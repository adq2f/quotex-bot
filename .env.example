# Copy to .env for local use. NEVER commit .env. On Render, set these in Environment tab.
ACCOUNT_TYPE=DEMO
EXECUTION_MODE=signal_only
QUOTEX_EMAIL=
QUOTEX_PASSWORD=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ASSET_WHITELIST=EURUSD_otc,GBPUSD_otc,USDJPY_otc
ENTRY_TF_SECONDS=300
EXPIRY_CANDLES=1

MAX_RISK_PCT=1
DAILY_LOSS_PCT=5
DAILY_PROFIT_PCT=3
MAX_CONSEC_LOSSES=3
COOLDOWN_MINUTES=30
DRAWDOWN_GUARD_PCT=15
MIN_PAYOUT_PCT=80
SCORE_THRESHOLD=75

MTG_ENABLED=false
MTG_MAX_STEPS=1
MTG_BASE_RISK_PCT=0.5

MAX_SIGNALS_PER_DAY=6
ASSET_LOSS_LOCK=2
NEWS_API_KEY=
DATABASE_URL=

# ---- v2.1 additions ----
DATA_SOURCE=synthetic
VIRTUAL_BALANCE=1000
DEFAULT_PAYOUT_PCT=85
INDICATOR_WINDOW=1
SMC_REQUIRE_FVG=true
SIGNAL_MAX_AGE_SECONDS=3
STOP_ON_DAILY_PROFIT=true
NEWS_FAIL_POLICY=block
DB_PATH=quotex_bot.db
ADMIN_KEY=change_me
ALLOW_REAL_EXECUTION=false
DAILY_REPORT_HOUR_UTC=17
NEWS_ENABLED=true

# ---- Web UI auth (NEW) ----
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=change_me_before_first_boot
SESSION_SECRET=replace_with_64_char_random_string
SESSION_COOKIE_SECURE=false

# ---- Cloudflare / proxy (NEW, REQUIRED on Render) ----
# Format: http://USERNAME:PASSWORD@HOST:PORT
QUOTEX_PROXY=
# Manual cookie fallback (browser DevTools -> Application -> Cookies -> ci_session at quotex.io)
QUOTEX_COOKIE=
