# Copy to .env for local use. NEVER commit .env. On Render, set these in Environment tab.

# ---- Account / mode ----
ACCOUNT_TYPE=DEMO
EXECUTION_MODE=signal_only
QUOTEX_EMAIL=mdtanviradil2@gmail.com
QUOTEX_PASSWORD=DDbb11$$

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=9154835416:AAGNrljv0jEjPTodNqMZGGiqFycjCICCuDA
TELEGRAM_CHAT_ID=-1004379094766

# ---- Assets ----
ASSET_WHITELIST=EURUSD_otc,GBPUSD_otc,USDJPY_otc,USDCAD_otc,AUDUSD_otc
ENTRY_TF_SECONDS=300
EXPIRY_CANDLES=1

# ---- Risk ----
MAX_RISK_PCT=1
DAILY_LOSS_PCT=5
DAILY_PROFIT_PCT=3
MAX_CONSEC_LOSSES=3
COOLDOWN_MINUTES=30
DRAWDOWN_GUARD_PCT=15
MIN_PAYOUT_PCT=80
SCORE_THRESHOLD=75

# ---- MTG ----
MTG_ENABLED=false
MTG_MAX_STEPS=1
MTG_BASE_RISK_PCT=0.5

# ---- Limits ----
MAX_SIGNALS_PER_DAY=6
ASSET_LOSS_LOCK=2
NEWS_API_KEY=
DATABASE_URL=

# ---- v2.1 ----
DATA_SOURCE=synthetic quotex
VIRTUAL_BALANCE=1000
DEFAULT_PAYOUT_PCT=85
INDICATOR_WINDOW=1
SMC_REQUIRE_FVG=true
SIGNAL_MAX_AGE_SECONDS=3
STOP_ON_DAILY_PROFIT=true
NEWS_FAIL_POLICY=block
DB_PATH=quotex_bot.db
ADMIN_KEY=DDbb11$$
ALLOW_REAL_EXECUTION=false
DAILY_REPORT_HOUR_UTC=17
NEWS_ENABLED=true

# ---- Turso Cloud DB (recommended on Render) ----
# Leave empty to use local SQLite. On Render Free, disk is ephemeral -> use Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Web UI auth ----
WEB_ADMIN_USERNAME=adq
WEB_ADMIN_PASSWORD=DDbb11$$
SESSION_SECRET=1f3f4cf08e7d345851fda6225d83c9faa90c72d93d15b1dbd5dc752677653b5a
SESSION_COOKIE_SECURE=false

# ---- Cloudflare / proxy ----
# Format: http://USERNAME:PASSWORD@HOST:PORT
QUOTEX_PROXY=

# ---- Quotex cookie: leave EMPTY here ----
# Provide cookie via the LOGIN PAGE instead (stored in DB, refreshable without redeploy).
# For local dev with no web login flow, you can paste it here as a fallback.
QUOTEX_COOKIE=

# ---- Keepalive (1h wake window) ----
# Render sets RENDER_EXTERNAL_URL automatically — nothing to do.
# Only set SELF_URL if self-hosting on a VPS without Render.
# SELF_URL=https://your-domain.com
